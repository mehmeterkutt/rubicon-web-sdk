{
  "name": "rubicon-analytics-core",
  "version": "0.0.0",
  "private": true,
  "description": "The DOM-free core of the Rubicon web analytics SDK. Bundled into rubicon-analytics, never published (Web Public API 7).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist-types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.src.json --noEmit && tsc -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  }
}
