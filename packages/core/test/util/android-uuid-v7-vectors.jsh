// Writes android-uuid-v7-vectors.ts: ids made by the Android UuidV7Generator, with the words of the
// random draws it made, so the web generator can replay them through ScriptedRandom (plan step 2.3).
// It runs the compiled Android classes (sdk-core main and testFixtures, Kotlin's standard library):
//
//   A=~/Projects/rubicon/rubicon-android-sdk/sdk-core/build/classes/kotlin
//   jshell --class-path "$A/main:$A/testFixtures:<kotlin-stdlib jar>" -q \
//     packages/core/test/util/android-uuid-v7-vectors.jsh > packages/core/test/util/android-uuid-v7-vectors.ts
//   pnpm format
//
// SeededRandom(seed) is the Android test fixture (Kotlin's Random(seed)). Kotlin's nextLong() is
// nextInt() shl 32 plus nextInt() sign-extended, so the words recorded are those of the Long the
// generator received, high word first, and of each Int; the web generator draws the same words in
// the same order.
import com.rubicon.analytics.internal.util.UuidV7Generator;
import com.rubicon.analytics.testing.FakeClock;
import com.rubicon.analytics.testing.SeededRandom;

class Recording extends kotlin.random.Random {
    final SeededRandom delegate;
    final StringBuilder words = new StringBuilder();
    boolean inLong = false;
    Recording(long seed) { delegate = new SeededRandom(seed); }
    public int nextBits(int bitCount) { return delegate.nextBits(bitCount); }
    void word(long w) { if (words.length() > 0) words.append(", "); words.append(w & 0xFFFFFFFFL); }
    public long nextLong() { inLong = true; long v = super.nextLong(); inLong = false; word(v >>> 32); word(v); return v; }
    public int nextInt() { int v = super.nextInt(); if (!inLong) word(v); return v; }
}

StringBuilder out = new StringBuilder();
void scenario(String name, long start, long seed, long counterMax, long[][] steps) {
    FakeClock clock = new FakeClock(start);
    Recording random = new Recording(seed);
    UuidV7Generator g = counterMax < 0 ? new UuidV7Generator(clock, random) : new UuidV7Generator(clock, random, counterMax);
    StringBuilder ids = new StringBuilder();
    StringBuilder stepText = new StringBuilder();
    for (long[] step : steps) {
        if (step[0] != 0) clock.advanceBy(step[0]);
        if (stepText.length() > 0) stepText.append(", ");
        stepText.append("{ advanceBy: " + step[0] + ", ids: " + step[1] + " }");
        for (int i = 0; i < step[1]; i++) ids.append("'" + g.next() + "', ");
    }
    out.append("  {\n    name: '" + name + "',\n    start: " + start + ",\n    seed: " + seed + ",\n");
    if (counterMax >= 0) out.append("    counterMax: " + counterMax + ",\n");
    out.append("    steps: [" + stepText + "],\n    words: [" + random.words + "],\n    ids: [" + ids + "],\n  },\n");
}
// The scenarios of the Android UuidV7GeneratorTest: its "same seed and clock" case (FakeClock at 0,
// SeededRandom(9)); its class fixture (FakeClock at 1_759_147_200_123, SeededRandom(1)) through one
// millisecond, a later one and the clock set back a day; its overflow case (counterMax = 7).
scenario("the same seed and clock", 0L, 9L, -1L, new long[][] {{0, 3}});
scenario("one millisecond, a later one, then the clock set back a day", 1759147200123L, 1L, -1L, new long[][] {{0, 5}, {5000, 2}, {-86400000L, 3}});
scenario("a 3-bit counter that overflows", 1759147200123L, 1L, 7L, new long[][] {{0, 40}});

System.out.print(
    "// Generated by android-uuid-v7-vectors.jsh from the Android UuidV7Generator (rubicon-android-sdk\n" +
    "// 2e1e8b1, unchanged at 99f27a4); do not edit. Each scenario: the clock start, the steps (move the\n" +
    "// clock, then make ids), the words of the random draws in order and the ids Android made.\n\n" +
    "export interface AndroidUuidV7Scenario {\n" +
    "  readonly name: string;\n" +
    "  readonly start: number;\n" +
    "  readonly seed: number;\n" +
    "  readonly counterMax?: number;\n" +
    "  readonly steps: readonly { readonly advanceBy: number; readonly ids: number }[];\n" +
    "  readonly words: readonly number[];\n" +
    "  readonly ids: readonly string[];\n" +
    "}\n\n" +
    "export const ANDROID_UUID_V7_SCENARIOS: readonly AndroidUuidV7Scenario[] = [\n" + out + "];\n");
/exit
