{
  "name": "rubicon-analytics",
  "version": "0.1.0",
  "description": "Rubicon analytics SDK for the browser.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubicon-team/rubicon-web-sdk.git",
    "directory": "packages/web"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/index.mjs",
    "dist/index.cjs",
    "dist/index.d.mts",
    "dist/index.d.cts",
    "dist/rubicon.min.js",
    "dist/*.map"
  ],
  "scripts": {
    "build": "rm -rf dist dist-types && tsc -p tsconfig.build.json && rollup -c rollup.config.mjs && node scripts/api.mjs build",
    "typecheck": "tsc -p tsconfig.src.json --noEmit && tsc -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "api": "node scripts/api.mjs check",
    "api:update": "node scripts/api.mjs update",
    "size": "size-limit",
    "ssr": "vitest run --config vitest.ssr.config.ts",
    "browser": "playwright test"
  },
  "devDependencies": {
    "rubicon-analytics-core": "workspace:*",
    "rubicon-analytics-testing": "workspace:*",
    "@microsoft/api-extractor": "7.59.4",
    "@playwright/test": "1.63.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@size-limit/file": "14.1.0",
    "axios": "1.20.0",
    "jsdom": "30.1.2",
    "rollup": "4.64.1",
    "size-limit": "14.1.0",
    "tslib": "2.8.1"
  }
}
